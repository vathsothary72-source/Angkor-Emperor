# ============================================================
# ANGKOR EMPEROR - ENVIRONMENT VARIABLES (EXAMPLE)
# ============================================================

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Gemini API Key (យកពី Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Secret (ប្តូរឲ្យវែង និងពិបាកទាយ)
ADMIN_SECRET=change_this_to_strong_secret

# HWID Secret
HWID_SECRET=change_this_to_strong_secret

# JWT Secret
JWT_SECRET=change_this_to_strong_secret

# Offline Token Secret
OFFLINE_SECRET=change_this_to_strong_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Threat Detection
THREAT_DETECTION_ENABLED=true

# Update Server
UPDATE_SERVER_URL=https://updates.angkor-emperor.com
UPDATE_CHANNEL=stable

# Logging
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true

# KHQR Payment
KHQR_MERCHANT_ID=010405530
KHQR_MERCHANT_NAME=KEM CHAN SOPHEAKTRA
KHQR_CURRENCY=USD

# Official Contact
TELEGRAM_USERNAME=PrinceOfSeal
TELEGRAM_LINK=https://t.me/PrinceOfSeal
SUPPORT_EMAIL=vathsothary72@gmail.com
